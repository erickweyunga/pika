# The program's environment: its arguments and environment variables.

:extern lib="pika" {
    :fn _arg_count -> i64
    :fn _arg index:i64 -> String
    :fn _env_has name:String -> bool
    :fn _env_get name:String -> String
}

# The arguments given to the program, after the program itself: `pika run app.pk a b`
# gives `{"a"; "b"}`.
:fn args -> List<String> do={
    :local result:List<String> {}
    :const count [:_arg_count]
    :local i 0
    :while ($i < $count) do={
        $result->push [:_arg $i]
        :set i ($i + 1)
    }
    :return $result
}

# The value of an environment variable, or none if it is not set or not valid UTF-8.
:fn var name:String -> String? do={
    :if (![:_env_has $name]) do={ :return none }
    :return [:_env_get $name]
}
