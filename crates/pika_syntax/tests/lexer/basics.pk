:local x:i64 5
:set x ($x + 1); :put $x
:fn add a:i64 b:i64 -> i64 do={ :return ($a + $b) }
:put [:add 1 2]
:put [/std/math/sqrt 2.0]
:for i from=1 to=10 step=2 do={ :put $i }
:local p Point{x=1.0; y=2.0}
:set ($p->x) ($p->y * 2.0)
:local c Color->red
:local m [:max<f64> 1.5 2.5]
:fn f self mut s:Self owned o:String -> nothing raises do={}
:if (($a and $b) or !$c && $d || ($e in $xs)) do={ :put true } else={ :put false }
:put (none) (some) (_)
:put (1 + 2 - 3 * 4 / 5 % 6)
:put (~$a & $b | $c ^ $d << 2)
:put ($a = $b) ($a != $b) ($a < $b) ($a <= $b) ($a > $b) ($a >= $b)
:put ("a" . "b") ($x as f64) (1, 2)
