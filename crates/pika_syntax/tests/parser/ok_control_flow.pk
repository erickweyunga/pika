:if ($x < 0) do={
    :put "negative"
} else=:if ($x = 0) do={
    :put "zero"
} else={
    :put "positive"
}
:if ($ok) do={ :put "yes" }
:while ($n > 0) do={ :set n ($n - 1) }
:do {
    :set n ($n + 1)
} while=($n < 10)
:for i from=0 to=10 do={ :put $i }
:for i from=10 until=0 step=-2 do={ :break }
:foreach x in=$list do={ :continue }
:foreach i,x in=$list do={ :put "$i: $x" }
:foreach mut x in=$list do={ :set x ($x * 2) }
:match $shape {
    Shape->circle _ r do={ :return (/math/pi * $r * $r) }
    Shape->rect a b if=($a = $b) do={ :return 0.0 }
    Expr->add (Expr->num x) _ do={ :put $x }
    /geo/Shape->point do={}
    some x do={ :put $x }
    none do={}
    0 do={}
    -1 do={}
    "text" do={}
    'c' do={}
    true do={}
    other do={ :put $other }
}
:onerror e in={
    :put [:parse_port "99999"]
} do={
    :put "failed: $e"
}
:unsafe {
    :const n [:strlen [$s->as_ptr]]
}
