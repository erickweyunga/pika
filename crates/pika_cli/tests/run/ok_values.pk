# Printing every kind of value, and arithmetic on each.
:const GREETING "Hello"
:put "$GREETING, Pika!"
:put 42
:put -7
:const MAX:u64 18446744073709551615
:put $MAX
:put (-9223372036854775807 - 1)
:put "floats: $(0.1 + 0.2) $(1.5 * 2.0) $(2.0 / 3.0) $(10.0 % 3.0) $(-0.0) $(1e300 * 10.0) $(1e20) $(0.00001234)"
:put "f32: $((1.0 / 3.0) as f32) $((16777217 as f32)) $((0.1 as f32) + (0.2 as f32))"
:put "durations: $(1m30s + 500ms) $(-2h) $(1d - 1ns) $(0s) $(1w > 6d)"
:put "chars: $('A') $('é') $('A' as u32) $('A' < 'B')"
:put "bools: $(true and !false) $(true or false) $(true = false) $(true != false)"
:put "division: $(7 / 2) $(-7 / 2) $(7 % -2) $(-7 % 2) $((-128 as i8) % (-1 as i8))"
:put "bits: $(0xF0 & 0x3C) $(0xF0 | 0x0F) $(0xFF ^ 0x0F) $(~0) $(~(0 as u8)) $(1 << 62) $(-16 >> 2) $((255 as u8) >> 4)"
:put "shifts by other types: $(1 << (3 as u8)) $((1 as u8) << 7) $((-1 as i8) >> (7 as i64))"
:put "casts: $(3.99 as i64) $(-3.99 as i64) $(-1.5 as u8) $(300.0 as u8) $(1e30 as i32) $(65 as f32) $((200 as u8) as i64) $(-1 as i16)"
:put "comparisons: $(1 < 2) $(2 <= 2) $(3 > 4) $(-1 < 0) $((255 as u8) > (1 as u8)) $(1.5 >= 1.5)"
:put "typeof: $[:typeof 1.5] $[:typeof 'c'] $[:typeof 10s] $[:typeof (1 as u16)] tostr: $[:tostr 42] $[:tostr 2.5]"

