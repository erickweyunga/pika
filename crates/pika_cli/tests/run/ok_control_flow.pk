# Control flow, functions, globals and loops at the edges of their ranges.
:global CALLS:i64 0

:fn count -> i64 do={
    :set CALLS ($CALLS + 1)
    :return $CALLS
}

:fn fib n:u64 -> u64 do={
    :if ($n < 2) do={ :return $n }
    :return ([:fib ($n - 1)] + [:fib ($n - 2)])
}

:fn is_even n:u32 -> bool do={
    :if ($n = 0) do={ :return true }
    :return [:is_odd ($n - 1)]
}

:fn is_odd n:u32 -> bool do={
    :if ($n = 0) do={ :return false }
    :return [:is_even ($n - 1)]
}

:fn scale value:f64 factor:f64=2.0 offset:f64=0.0 -> f64 do={
    :return ($value * $factor + $offset)
}

:fn sign n:i64 -> i64 do={
    :if ($n < 0) do={
        :return -1
    } else=:if ($n = 0) do={
        :return 0
    } else={
        :return 1
    }
}

:fn first_multiple n:i64 of:i64 -> i64 do={
    :local i $n
    :while (true) do={
        :if (($i % $of) = 0) do={ :return $i }
        :set i ($i + 1)
    }
}

:put "fib(30) = $[:fib 30]"
:put "even(10) = $[:is_even 10], odd(7) = $[:is_odd 7]"
:put "scale: $[:scale 3.0] $[:scale 3.0 offset=1.0] $[:scale factor=10.0 value=0.5]"
:put "signs: $[:sign -5] $[:sign 0] $[:sign 9]"
:put "first multiple of 7 from 50: $[:first_multiple 50 7]"

# Evaluation order and short-circuiting.
:put "order: $[:count] $[:count] $CALLS"
:put "short-circuit: $(false and ([:count] > 0)) $(true or ([:count] > 0)) calls=$CALLS"

# Loops.
:local total 0
:for i from=1 to=100 do={ :set total ($total + $i) }
:put "sum 1..100 = $total"
:for i from=10 until=0 step=-3 do={ :put "down $i" }
:for b from=(250 as u8) to=255 do={ :put "u8 $b" }
:for b from=(-128 as i8) until=-125 do={ :put "i8 $b" }
:for b from=(127 as i8) to=-128 step=-100 do={ :put "big step $b" }
:for b from=(0 as u8) to=255 step=100 do={ :put "u8 step $b" }
:const step 4
:for i from=0 to=10 step=$step do={ :put "variable step $i" }
:for i from=5 to=1 do={ :put "never printed" }
:local n 0
:while ($n < 10) do={
    :set n ($n + 1)
    :if (($n % 2) = 0) do={ :continue }
    :if ($n > 7) do={ :break }
    :put "odd $n"
}
:do {
    :set n ($n - 3)
    :put "do-while $n"
} while=($n > 0)
:local pairs 0
:for i from=1 to=3 do={
    :for j from=1 to=3 do={
        :if ($j > $i) do={ :break }
        :set pairs ($pairs + 1)
    }
}
:put "nested pairs = $pairs"
:local later:i64
:if ($total > 0) do={ :set later 1 } else={ :set later 2 }
:put "later = $later"
