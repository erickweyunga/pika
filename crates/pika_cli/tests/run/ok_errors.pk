# Errors: `raises`, `:error`, `:onerror`, propagation, causes, and errors through traits,
# generics, loops and nested handlers.

:fn parse_port s:String -> u16 raises do={
    :if ([:len $s] = 0) do={ :error "empty port" }
    :if ($s = "99999") do={ :error "port out of range: $s" }
    :return 8080
}
:fn load name:String -> String raises do={
    :onerror e in={
        :const port [:parse_port? $name]
        :return "loaded $port"
    } do={
        :error "could not load $name" source=$e
    }
}
:fn ports do={
    :onerror e in={
        :put "port = $([:parse_port? "8080"])"
        :put "port = $([:parse_port? "99999"])"
        :put "not reached"
    } do={
        :put "failed: $e"
        :put "at $($e->line):$($e->column)"
    }
    :onerror e in={
        :put [:load? "x"]
        :put [:load? ""]
    } do={
        :put "load failed: $e"
        :match $e->source {
            some cause do={ :put "because: $($cause->value)" }
            none do={}
        }
    }
}

:trait Source {
    :fn read self -> String raises
    :fn read_twice self -> String raises do={
        :const a [$self->read?]
        :return "$a$([$self->read?])"
    }
}
:struct Good impl=Source {
    text:String
    :fn read self -> String raises do={ :return [$self->text->clone] }
}
:struct Broken impl=Source {
    :fn read self -> String raises do={ :error "broken source" }
}
:fn first<T: Source> items:List<T> -> String raises do={
    :foreach item in=$items do={ :return [$item->read_twice?] }
    :error "no sources"
}
:fn attempt<T: Source> s:T -> String do={
    :onerror e in={ :return [$s->read_twice?] } do={ :return "failed: $e" }
}
:fn count_until_error -> i64 do={
    :local n 0
    :while (true) do={
        :onerror e in={
            :if ($n = 3) do={ :error "stop at $n" }
            :set n ($n + 1)
        } do={
            :put "loop ended: $e"
            :break
        }
    }
    :return $n
}
:fn rethrow -> i64 raises do={
    :onerror e in={
        :onerror inner in={ :error "deep" } do={ :error "middle" source=$inner }
    } do={
        :put "outer saw: $e"
        :error $e
    }
    :return 0
}
:fn sources do={
    :put [:attempt Good{text="ab"}]
    :put [:attempt Broken{}]
    :onerror e in={ :put [:first? {Good{text="x"}}] } do={ :put $e }
    :onerror e in={ :put [:first? List<Good>{}] } do={ :put $e }
    :put [:count_until_error]
    :onerror e in={ :put [:rethrow?] } do={
        :put "main saw: $e (line $($e->line))"
        :const errors {$e; [$e->clone]}
        :put $errors
    }
}

:fn main do={
    :ports
    :sources
}
