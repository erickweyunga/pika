# Moves and `mut` arguments, with lists, which move; strings are copied instead (spec
# section 12.1), as the last function shows.
:global shared:List<i64> {}
:fn take owned items:List<i64> do={ :put $items }
:fn read items:List<i64> do={ :put $items }
:fn change mut items:List<i64> do={ :set items {9} }
:fn both mut a:List<i64> b:List<i64> do={ :put "$a $b" }

:fn use_after_move do={
    :local a {1}
    :take $a
    :put $a
}

:fn maybe_moved flag:bool do={
    :local b {2}
    :if ($flag) do={ :take $b }
    :read $b
}

:fn moved_in_loop do={
    :local c {3}
    :for i from=1 to=2 do={ :take $c }
}

:fn move_out_of_borrow items:List<i64> -> List<i64> do={
    :return $items
}

:fn move_out_of_global do={
    :local g $shared
    :put $g
}

:fn bad_mut_arguments limit:i64 do={
    :const fixed {4}
    :change $fixed
    :change {5}
    :local s {6}
    :both $s $s
    :for i from=1 to=2 do={ :put $i }
}

:fn fine do={
    :local d {7}
    :take [$d->clone]
    :read $d
    :take $d
    :set d {8}
    :read $d
    :change $shared
    :local e {9}
    :change $e
    :read $e
}

:fn keep owned text:String -> String do={ :return $text }

:fn strings_are_copied text:String do={
    :const a "a"
    :const b [:keep $a]
    :put "$a $b"
    :const c $text
    :put "$text $c"
}
