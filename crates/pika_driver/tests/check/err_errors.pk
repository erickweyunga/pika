# Errors raised where nothing catches them, and invalid `:error`, `:onerror` and `raises`.
:fn risky -> i64 raises do={ :return 1 }
:fn plain -> i64 do={ :return [:risky?] }
:fn fails do={ :error "nope" }
:fn bad_value -> i64 raises do={ :error 5 }
:fn chained raises do={
    :const e Error{message="x"}
    :error $e source=$e
}
:trait Loader {
    :fn load self -> String raises
}
:struct Disk impl=Loader {
    :fn load self -> String do={ :return "ok" }
}
:struct Show impl=Display {
    :fn fmt self mut out:Formatter raises do={}
}
:const c [:risky?]
:fn main do={
    :onerror e in={ :put [:risky?] } do={
        :set e Error{message="y"}
        :put [:risky?]
    }
    :put $e
}
