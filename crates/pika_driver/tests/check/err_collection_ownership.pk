# Ownership errors involving lists, maps and sets.

:fn main do={
    :const fixed {1; 2}
    $fixed->push 3
    :local lists {{1}; {2}}
    :const first $lists->0
    :foreach n in=$lists do={
        $lists->push {3}
        :set lists {}
    }
    :foreach mut n in=$lists do={
        :const taken $n
    }
    :const copy $lists
    :put $lists
    :const twice {4}
    :const pair {$twice; $twice}
}
